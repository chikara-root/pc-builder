# Django Core Settings
# ---------------------
# SECURITY WARNING: Use a strong, unique secret key in production!
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# SECURITY WARNING: Don't run with debug turned on in production!
# Set to 'True' for development, 'False' for production
DJANGO_DEBUG=True

# Comma-separated list of allowed host/domain names
# For production, set to your actual domain(s), e.g., "example.com,www.example.com"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings
# -------------
# Comma-separated list of allowed origins for CORS
# For production, set to your frontend domain(s), e.g., "https://example.com,https://www.example.com"
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500

# Comma-separated list of trusted origins for CSRF
# For production, set to your frontend domain(s), e.g., "https://example.com,https://www.example.com"
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500

# Static and Media Files
# ----------------------
# Absolute path to the directory where collectstatic will collect static files for deployment
# Default: BASE_DIR/staticfiles
DJANGO_STATIC_ROOT=/app/staticfiles

# Absolute path to the directory where user-uploaded files will be stored
# Default: BASE_DIR/media
DJANGO_MEDIA_ROOT=/app/media

# Email Settings (Optional)
# -------------------------
# SMTP configuration for sending emails
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=

# Database Settings (Optional - for PostgreSQL in production)
# -----------------------------------------------------------
# Uncomment and configure for PostgreSQL production database
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=pc_builder
# DJANGO_DB_USER=pc_builder_user
# DJANGO_DB_PASSWORD=your-db-password
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432

# Django Settings Module
# ----------------------
# Set to 'pc_builder_backend.settings' for development
# Set to 'pc_builder_backend.settings_production' for production
# DJANGO_SETTINGS_MODULE=pc_builder_backend.settings